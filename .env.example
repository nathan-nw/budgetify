# Supabase project credentials.
# Create a free project at https://supabase.com, then copy these from
# Project Settings -> API. Save a copy as `.env.local` (gitignored).

# Project URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (safe to expose to the browser; RLS protects the data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
